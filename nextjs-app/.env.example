# Postgres connection string used by @payloadcms/db-postgres.
# Neon for both local dev and production — copy the pooled connection
# string from the Neon dashboard (use a separate dev branch/project so
# local work never touches production data).
DATABASE_URI=postgres://user:password@ep-example-123456.region.aws.neon.tech/takemyjunk?sslmode=require

# Any long random string. Generate one with: openssl rand -base64 32
PAYLOAD_SECRET=changeme-generate-a-real-secret

# Absolute site URL — powers canonical URLs, sitemap, robots, JSON-LD, and
# Open Graph. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Vercel Blob storage read/write token. Leave unset for local dev — Payload
# media then falls back to local filesystem storage automatically. Vercel
# sets this for you when you attach a Blob store to the project.
BLOB_READ_WRITE_TOKEN=

# Optional: GA4 measurement ID. Analytics/tracking code no-ops when unset —
# never fake a tracking ID here.
NEXT_PUBLIC_GA_ID=
